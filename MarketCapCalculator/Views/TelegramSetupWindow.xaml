<Window x:Class="MarketCapCalculator.Views.TelegramSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        Title="Configurazione Telegram"
        Height="780"
        Width="660"
        MinHeight="640"
        MinWidth="620"
        Background="#121212"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        FontFamily="Segoe UI"
        ShowInTaskbar="True"
        WindowStyle="SingleBorderWindow">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<!-- Contenuto scrollabile -->
			<RowDefinition Height="Auto"/>
			<!-- Pulsanti fissi in basso -->
		</Grid.RowDefinitions>

		<!-- Contenuto scrollabile -->
		<ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,24,24,0">
			<StackPanel>

				<!-- Titolo -->
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
					<!-- <TextBlock Text="" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/> -->
					<TextBlock Text="Configurazione Telegram" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
				</StackPanel>

				<!-- Sottotitolo -->
				<TextBlock Text="Per ricevere i codici di recupero password, collega un tuo bot Telegram. Ci vogliono 2 minuti."
                           FontSize="12"
                           Foreground="#AAAAAA"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,18"/>

				<!-- Istruzioni -->
				<Border Background="#1A1A1A"
                        BorderBrush="#2A2A2A"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0,0,0,18">
					<StackPanel>
						<TextBlock Text="PASSAGGI"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#00C853"
                                   Margin="0,0,0,10"/>

						<TextBlock FontSize="12" Foreground="#CCCCCC" Margin="0,0,0,6">
							<Run Text="1) Apri Telegram e cerca "/>
							<Run Text="@BotFather" FontWeight="Bold" Foreground="#4A90E2"/>
						</TextBlock>
						<TextBlock FontSize="12" Foreground="#CCCCCC" Margin="0,0,0,6">
							<Run Text="2) Invia "/>
							<Run Text="/newbot" FontFamily="Consolas" Foreground="#00C853"/>
							<Run Text=" e segui le istruzioni"/>
						</TextBlock>
						<TextBlock Text="3) Copia il token che BotFather ti fornisce" FontSize="12" Foreground="#CCCCCC" Margin="0,0,0,6"/>
						<TextBlock Text="4) Apri la chat con il tuo bot e premi START" FontSize="12" Foreground="#CCCCCC" Margin="0,0,0,6"/>
						<TextBlock FontSize="12" Foreground="#CCCCCC" Margin="0,0,0,10">
							<Run Text="5) Ottieni il tuo "/>
							<Run Text="Chat ID" FontWeight="Bold" Foreground="#4A90E2"/>
							<Run Text=" usando il bot "/>
							<Run Text="@userinfobot" FontWeight="Bold" Foreground="#4A90E2"/>
						</TextBlock>

						<!-- Bottoni affiancati -->
						<UniformGrid Columns="2" Margin="0,12,0,0">

							<Button Content="Apri @BotFather"
									Click="OpenBotFather_Click"
									Background="#4A90E2"
									Foreground="White"
									FontSize="11"
									FontWeight="SemiBold"
									Height="34"
									Margin="0,0,5,0"
									Cursor="Hand"/>

							<Button Content="Apri @Userinfobot"
									Click="OpenUserInfo_Click"
									Background="#4A90E2"
									Foreground="White"
									FontSize="11"
									FontWeight="SemiBold"
									Height="34"
									Margin="5,0,0,0"
									Cursor="Hand"/>

						</UniformGrid>
					</StackPanel>
				</Border>

				<!-- Bot Token -->
				<TextBlock Text="Bot Token" FontSize="11" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,4"/>
				<TextBox x:Name="BotTokenTextBox"
                         Height="36"
                         FontSize="13"
                         Foreground="#FFFFFF"
                         Background="#2D2D2D"
                         BorderBrush="#3A3A3A"
                         BorderThickness="1"
                         VerticalContentAlignment="Center"
                         Padding="10,6"
                         Margin="0,0,0,12"/>

				<!-- Chat ID -->
				<TextBlock Text="Chat ID" FontSize="11" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,4"/>
				<TextBox x:Name="ChatIdTextBox"
                         Height="36"
                         FontSize="13"
                         Foreground="#FFFFFF"
                         Background="#2D2D2D"
                         BorderBrush="#3A3A3A"
                         BorderThickness="1"
                         VerticalContentAlignment="Center"
                         Padding="10,6"
                         Margin="0,0,0,12"/>

				<!-- Status -->
				<TextBlock x:Name="StatusText"
                           Text=""
                           FontSize="11"
                           Foreground="#00C853"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,12"/>
			</StackPanel>
		</ScrollViewer>

		<!-- Pulsanti fissi in basso -->
		<Border Grid.Row="1" Background="#181818" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Padding="24,16">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="10"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="10"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<Button Grid.Column="0"
                        Content="SALVA"
                        Click="SaveButton_Click"
                        Background="#00C853"
                        Foreground="#1A1A1A"
                        FontWeight="Bold"
                        Height="42"
                        Cursor="Hand"/>

				<Button Grid.Column="2"
                        Content="TESTA"
                        Click="TestButton_Click"
                        Background="#4A90E2"
                        Foreground="White"
                        FontWeight="Bold"
                        Height="42"
                        Cursor="Hand"/>

				<Button Grid.Column="4"
                        Content="SALTA"
                        Click="SkipButton_Click"
                        Background="#3A3A3A"
                        Foreground="#FFFFFF"
                        FontWeight="SemiBold"
                        Height="42"
                        Cursor="Hand"/>
			</Grid>
		</Border>
	</Grid>
</Window>