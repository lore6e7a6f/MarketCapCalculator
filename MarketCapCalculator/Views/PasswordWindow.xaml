<Window x:Class="MarketCapCalculator.Views.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sicurezza"
        Height="380"
        Width="400"
        Background="#121212"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        ShowInTaskbar="True"
        WindowStyle="SingleBorderWindow"
        Topmost="True">
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- <TextBlock Grid.Row="0" Text="" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10"/> -->
		<TextBlock Grid.Row="1" x:Name="TitleText" Text="PASSWORD" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,5"/>
		<TextBlock Grid.Row="2" x:Name="SubtitleText" Text="" FontSize="11" Foreground="#888888" HorizontalAlignment="Center" Margin="0,0,0,15"/>

		<PasswordBox Grid.Row="3" x:Name="PasswordInput" Height="40" FontSize="14" Foreground="#FFFFFF" Background="#2D2D2D" BorderBrush="#4A4A4A" BorderThickness="1.5" Padding="10,8" VerticalContentAlignment="Center" KeyDown="PasswordInput_KeyDown"/>

		<Border Grid.Row="4" x:Name="ErrorBorder" Background="#2A1A1A" BorderBrush="#FF5252" BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,10,0,0" Visibility="Collapsed">
			<StackPanel>
				<TextBlock x:Name="ErrorText" FontSize="11" Foreground="#FF5252" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Center"/>
				<TextBlock x:Name="AttemptsText" FontSize="10" Foreground="#FF8888" HorizontalAlignment="Center" Margin="0,4,0,0"/>
			</StackPanel>
		</Border>

		<Grid Grid.Row="5" Margin="0,15,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="10"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<Button Grid.Column="0" x:Name="ConfirmButton" Content="CONFERMA" Click="ConfirmButton_Click" Background="#00C853" Foreground="#1A1A1A" FontWeight="Bold" Height="40" Cursor="Hand"/>
			<Button Grid.Column="2" Content="ANNULLA" Click="CancelButton_Click" Background="#444444" Foreground="#FFFFFF" Height="40" Cursor="Hand"/>
		</Grid>

		<!-- Pulsante di recupero password: visibile solo in modalità login -->
		<Button Grid.Row="6"
                x:Name="ForgotPasswordButton"
                Content="Recupera via Telegram"
                Click="ForgotPassword_Click"
                Background="Transparent"
                Foreground="#4A90E2"
                FontSize="11"
                Cursor="Hand"
                BorderThickness="0"
                HorizontalAlignment="Center"
                Margin="0,15,0,0"
                Visibility="Collapsed"/>
	</Grid>
</Window>