<Window x:Class="MarketCapCalculator.Views.ApiKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurazione API CoinMarketCap"
        Height="340"
        Width="540"
        Background="#121212"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="API CoinMarketCap" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="1" Text="Inserisci la tua API key di CoinMarketCap. Verrà usata per ottenere supply e prezzo. Per i grafici storici usiamo fonti gratuite (CoinGecko / Binance)." FontSize="12" Foreground="#CCCCCC" TextWrapping="Wrap" Margin="0,0,0,15"/>

        <Button Grid.Row="2" Content="Come ottenere la API key" Click="OpenInfoUrl_Click" Background="#4A90E2" Foreground="White" FontSize="12" Padding="10,6" HorizontalAlignment="Left" Cursor="Hand"/>

        <TextBlock Grid.Row="3" Text="API Key:" FontSize="12" Foreground="#CCCCCC" Margin="0,15,0,5"/>
        <TextBox Grid.Row="4" x:Name="ApiKeyTextBox" Height="36" FontSize="13" Foreground="#FFFFFF" Background="#2D2D2D" BorderBrush="#4A4A4A" VerticalContentAlignment="Center" Padding="8,6"/>

        <TextBlock Grid.Row="5" x:Name="ErrorText" Text="" FontSize="11" Foreground="#FF5252" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,10,0,0"/>

        <Grid Grid.Row="6" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="SALVA" Click="SaveButton_Click" Background="#00C853" Foreground="#1A1A1A" FontWeight="Bold" Height="40" Cursor="Hand"/>
            <Button Grid.Column="2" Content="SALTA" Click="SkipButton_Click" Background="#444444" Foreground="#FFFFFF" Height="40" Padding="16,8" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>