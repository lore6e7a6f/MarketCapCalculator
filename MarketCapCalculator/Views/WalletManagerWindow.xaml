<Window x:Class="MarketCapCalculator.Views.WalletManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestione Wallet" 
        Height="700" 
        Width="900"
        Background="#121212"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Titolo -->
        <TextBlock Grid.Row="0" 
                   Text="GESTIONE WALLET SOLANA" 
                   FontSize="20" 
                   FontWeight="Bold"
                   Foreground="#FFFFFF"
                   Margin="0,0,0,20"/>
        
        <!-- Importa Wallet -->
        <Border Grid.Row="1" Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="3" Padding="15" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="AGGIUNGI WALLET" 
                           FontSize="14" 
                           FontWeight="Bold"
                           Foreground="#FFFFFF"
                           Margin="0,0,0,15"/>
                
                <!-- Nome Wallet -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" 
                               Text="Nome Wallet:" 
                               FontSize="12"
                               Foreground="#AAAAAA"
                               VerticalAlignment="Center"/>
                    
                    <TextBox Grid.Column="1" 
                             x:Name="WalletNameTextBox"
                             Height="36"
                             FontSize="12"
                             Foreground="#FFFFFF"
                             Background="#2D2D2D"
                             VerticalContentAlignment="Center"
                             Padding="10,6"
                             ToolTip="Dai un nome al tuo wallet (es: Main, Trading, ecc.)"/>
                </Grid>
                
                <!-- Indirizzo Solana -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" 
                               Text="Indirizzo Solana:" 
                               FontSize="12"
                               Foreground="#AAAAAA"
                               VerticalAlignment="Center"/>
                    
                    <TextBox Grid.Column="1" 
                             x:Name="WalletAddressTextBox"
                             Height="36"
                             FontSize="12"
                             Foreground="#FFFFFF"
                             Background="#2D2D2D"
                             VerticalContentAlignment="Center"
                             Padding="10,6"
                             ToolTip="Incolla qui il tuo indirizzo Solana"/>
                </Grid>
                
                <!-- Bottone Aggiungi -->
                <Button x:Name="ImportButton"
                        Content="AGGIUNGI WALLET"
                        Click="ImportWallet_Click"
                        Background="#00C853"
                        Foreground="#1A1A1A"
                        FontWeight="Bold"
                        Height="40"
                        Padding="16,8"
                        Cursor="Hand"
                        HorizontalAlignment="Right"
                        MinWidth="200"/>
                
                <TextBlock Text="Trovi il tuo indirizzo in Phantom Wallet cliccando sul tuo account in alto" 
                           FontSize="10"
                           Foreground="#888888"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- Lista Wallet -->
        <Border Grid.Row="2" Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="3" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" 
                               Text="I TUOI WALLET" 
                               FontSize="14" 
                               FontWeight="Bold"
                               Foreground="#FFFFFF"/>
                    
                    <Button Grid.Column="1" 
                            x:Name="RefreshButton"
                            Content="⟳ AGGIORNA SALDI"
                            Click="RefreshBalances_Click"
                            Background="#4A90E2"
                            Foreground="White"
                            FontSize="11"
                            Height="30"
                            Padding="12,6"
                            Cursor="Hand"/>
                </Grid>
                
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="WalletListBox">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#2A2A2A" 
                                        BorderBrush="#3A3A3A" 
                                        BorderThickness="1" 
                                        CornerRadius="3" 
                                        Padding="12" 
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <Ellipse Grid.Column="0" 
                                                Width="10" 
                                                Height="10" 
                                                Fill="#AB9FF2" 
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center"/>
                                        
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DisplayName}" 
                                                    FontSize="14" 
                                                    FontWeight="Bold"
                                                    Foreground="#FFFFFF"/>
                                            <TextBlock Text="{Binding DisplayAddress}" 
                                                    FontSize="10"
                                                    Foreground="#888888"
                                                    Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding DisplayLastUpdated, StringFormat='Aggiornato: {0}'}" 
                                                    FontSize="9"
                                                    Foreground="#666666"
                                                    Margin="0,2,0,0"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="2" Margin="0,0,15,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplaySolBalance}" 
                                                    FontSize="13" 
                                                    FontWeight="Bold"
                                                    Foreground="#AB9FF2"
                                                    HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding DisplayEurBalance}" 
                                                    FontSize="11" 
                                                    FontWeight="Bold"
                                                    Foreground="#00C853"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,2,0,0"/>
                                        </StackPanel>
                                        
                                        <Button Grid.Column="3" 
                                                Content="✕"
                                                Click="DeleteWallet_Click"
                                                Tag="{Binding Id}"
                                                Background="#FF5252"
                                                Foreground="White"
                                                Width="30"
                                                Height="30"
                                                FontSize="14"
                                                Cursor="Hand"
                                                VerticalAlignment="Center"
                                                ToolTip="Elimina wallet"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>