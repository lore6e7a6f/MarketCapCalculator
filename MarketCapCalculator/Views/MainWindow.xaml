<Window x:Class="MarketCapCalculator.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:vm="clr-namespace:MarketCapCalculator.ViewModels"
        Title="Market Cap Calculator Pro"
        Height="1000"
        Width="1600"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

	<Window.DataContext>
		<vm:MainViewModel/>
	</Window.DataContext>

	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- RIGA 1: Header -->
		<Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0" Margin="0,0,15,0">
					<TextBlock Text="MARKET CAP CALCULATOR PRO" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
					<StackPanel Orientation="Horizontal" Margin="0,4,0,0">
						<TextBlock Text="Developed by: " FontSize="11" Foreground="#888888"/>
						<TextBlock Text="lore6e7a6f" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Cursor="Hand" MouseLeftButtonDown="OpenGitHubProfile"/>
					</StackPanel>
				</StackPanel>

				<Border Grid.Column="1" Background="#2A2A2A" BorderBrush="#4A4A4A" BorderThickness="1" CornerRadius="3" Padding="8,4" VerticalAlignment="Center">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>

						<!-- <TextBlock Grid.Column="0" Text="" FontSize="14" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,8,0"/> -->
						<TextBox Grid.Column="1" x:Name="SearchTextBox" Height="32" FontSize="13" Foreground="#FFFFFF" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" KeyDown="SearchTextBox_KeyDown"/>
						<Button Grid.Column="2" Content="CERCA" Click="SearchButton_Click" Background="#4A90E2" Foreground="White" FontSize="11" Height="30" Padding="12,4" Margin="4,0,0,0" Cursor="Hand"/>
					</Grid>
				</Border>

				<!-- Rimosso StackPanel con bottoni Cambia Password e Logout -->
				<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
				</StackPanel>
			</Grid>
		</Border>

		<!-- RIGA 2: Wallet + Axiom/Fomo -->
		<Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="10"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="10"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<!-- Sezione Investimento con Wallet -->
				<Border Grid.Column="0" Style="{StaticResource CardStyle}">
					<StackPanel Orientation="Vertical" VerticalAlignment="Center">
						<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
							<CheckBox IsChecked="{Binding UseWalletBalance}" VerticalAlignment="Center" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold" Content=" INVESTI SOLO CON WALLET" Cursor="Hand"/>
							<TextBlock Text="Wallet:" FontSize="12" Foreground="#CCCCCC" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0,8,0"/>
							<ComboBox ItemsSource="{Binding Wallets}" SelectedItem="{Binding SelectedWallet}" DisplayMemberPath="DisplayName" Width="180" Height="32" Background="#2D2D2D" Foreground="#FFFFFF" BorderBrush="#4A4A4A" FontSize="12" VerticalContentAlignment="Center" IsEnabled="{Binding UseWalletBalance}">
								<ComboBox.ItemContainerStyle>
									<Style TargetType="ComboBoxItem">
										<Setter Property="Background" Value="#2D2D2D"/>
										<Setter Property="Foreground" Value="#FFFFFF"/>
										<Setter Property="Padding" Value="10,8"/>
										<Setter Property="FontSize" Value="12"/>
										<Style.Triggers>
											<Trigger Property="IsHighlighted" Value="True">
												<Setter Property="Background" Value="#4A90E2"/>
												<Setter Property="Foreground" Value="#FFFFFF"/>
											</Trigger>
											<Trigger Property="IsSelected" Value="True">
												<Setter Property="Background" Value="#4A90E2"/>
												<Setter Property="Foreground" Value="#FFFFFF"/>
											</Trigger>
										</Style.Triggers>
									</Style>
								</ComboBox.ItemContainerStyle>
							</ComboBox>
							<TextBlock Text="Saldo:" FontSize="12" Foreground="#CCCCCC" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0,8,0"/>
							<Border Background="#1A2A1A" BorderBrush="#00C853" BorderThickness="1" CornerRadius="3" Padding="10,4">
								<TextBlock Text="{Binding MaxInvestableDisplay}" FontSize="12" FontWeight="Bold" Foreground="#00C853"/>
							</Border>
						</StackPanel>

						<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
							<TextBlock Text="% Investimento:" FontSize="12" Foreground="#CCCCCC" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
							<Slider x:Name="InvestmentSlider" Minimum="1" Maximum="100" Value="{Binding InvestmentPercentage}" Width="200" Height="24" VerticalAlignment="Center" IsEnabled="{Binding UseWalletBalance}" TickFrequency="5" TickPlacement="BottomRight" IsSnapToTickEnabled="True"/>
							<Border Background="#2D2D2D" BorderBrush="#4A90E2" BorderThickness="1" CornerRadius="3" Padding="10,4" Margin="8,0,0,0">
								<StackPanel Orientation="Horizontal">
									<TextBlock Text="{Binding InvestmentPercentage}" FontSize="12" FontWeight="Bold" Foreground="#4A90E2"/>
									<TextBlock Text="%" FontSize="12" FontWeight="Bold" Foreground="#4A90E2" Margin="2,0,0,0"/>
								</StackPanel>
							</Border>
							<TextBlock Text="=" FontSize="12" FontWeight="Bold" Foreground="#888888" VerticalAlignment="Center" Margin="8,0"/>
							<Border Background="#1A2A1A" BorderBrush="#00C853" BorderThickness="1" CornerRadius="3" Padding="10,4">
								<TextBlock Text="{Binding CalculatedInvestmentDisplay}" FontSize="12" FontWeight="Bold" Foreground="#00C853"/>
							</Border>
							<Button Content="MAX" Click="UseMaxButton_Click" Background="#4A90E2" Foreground="White" FontSize="11" FontWeight="Bold" Height="32" Width="50" Margin="8,0,0,0" Cursor="Hand" Visibility="{Binding UseWalletBalance, Converter={StaticResource BoolToVisibilityConverter}}"/>
						</StackPanel>
					</StackPanel>
				</Border>

				<!-- Sezione Gestione Wallet -->
				<Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="15">
					<StackPanel Orientation="Vertical" VerticalAlignment="Center">
						<TextBlock Text="GESTIONE" FontSize="10" Foreground="#888888" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
						<Button Content=" GESTISCI WALLET" Click="OpenWalletManager_Click" Background="#AB9FF2" Foreground="#1A1A1A" FontWeight="Bold" FontSize="12" Height="36" Padding="16,8" Cursor="Hand"/>
					</StackPanel>
				</Border>

				<!-- Sezione Trading -->
				<Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="15">
					<StackPanel Orientation="Vertical" VerticalAlignment="Center">
						<TextBlock Text="TRADING" FontSize="10" Foreground="#888888" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
						<StackPanel Orientation="Horizontal">
							<Button Content="AXIOM" Command="{Binding OpenAxiomCommand}" Background="#FF6B35" Margin="4,0" Padding="16,8" FontWeight="Bold" FontSize="12"/>
							<Button Content="FOMO" Command="{Binding OpenFomoCommand}" Background="#8B5CF6" Margin="4,0" Padding="16,8" FontWeight="Bold" FontSize="12"/>
						</StackPanel>
					</StackPanel>
				</Border>
			</Grid>
		</Border>

		<!-- RIGA 3: Risultati ricerca -->
		<Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,10" x:Name="SearchResultsPanel" Visibility="Collapsed">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<Grid Grid.Row="0" Margin="0,0,0,8">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>
					<TextBlock Grid.Column="0" x:Name="SearchResultsTitle" Text="RISULTATI RICERCA" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
					<Button Grid.Column="1" Content="✕" Click="CloseSearchResults_Click" Background="#444444" Foreground="White" Width="30" Height="30" FontSize="14" Cursor="Hand"/>
				</Grid>

				<ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
					<ItemsControl x:Name="SearchResultsList">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Orientation="Horizontal"/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border Background="#2A2A2A" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,8,0" Width="250" Cursor="Hand" MouseLeftButtonDown="TokenResult_Click">
									<StackPanel>
										<StackPanel Orientation="Horizontal">
											<TextBlock Text="{Binding DisplaySymbol}" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
											<TextBlock Text="{Binding Name}" FontSize="11" Foreground="#888888" Margin="8,2,0,0"/>
										</StackPanel>
										<TextBlock Text="{Binding DisplayPrice}" FontSize="13" FontWeight="SemiBold" Foreground="#00C853" Margin="0,4,0,0"/>
										<TextBlock Text="{Binding DisplayMarketCap, StringFormat='MC: {0}'}" FontSize="10" Foreground="#888888" Margin="0,2,0,0"/>
									</StackPanel>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</Grid>
		</Border>

		<!-- RIGA 4: Main Content -->
		<Grid Grid.Row="3" Margin="0,0,0,10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="380"/>
				<ColumnDefinition Width="10"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- Left Panel: Input + Results -->
			<Grid Grid.Column="0">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
					<StackPanel>
						<TextBlock Text="PARAMETRI INPUT" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12"/>

						<Grid Margin="0,6,0,0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Nome Token:" Style="{StaticResource InputLabelStyle}" Margin="0,0,8,0" VerticalAlignment="Center"/>
							<TextBox Grid.Column="1" Text="{Binding TokenNameInput, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,6" VerticalContentAlignment="Center"/>
						</Grid>

						<Grid Margin="0,6,0,0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="Investimento (€):" Style="{StaticResource InputLabelStyle}" Margin="0,0,8,0" VerticalAlignment="Center"/>
							<TextBox Grid.Column="1" Text="{Binding InvestmentInput, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,6" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Background="#2D2D2D" VerticalContentAlignment="Center"/>
							<Button Grid.Column="2" Content="MAX" Click="UseMaxButton_Click" Background="#4A90E2" Foreground="White" FontSize="10" Height="36" Padding="8,4" Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Hand" Visibility="{Binding UseWalletBalance, Converter={StaticResource BoolToVisibilityConverter}}"/>
						</Grid>

						<Grid Margin="0,6,0,0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="MC Attuale:" Style="{StaticResource InputLabelStyle}" Margin="0,0,8,0" VerticalAlignment="Center"/>
							<TextBox Grid.Column="1" Text="{Binding CurrentMarketCapInput, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,6" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Background="#2D2D2D" VerticalContentAlignment="Center"/>
						</Grid>

						<Grid Margin="0,6,0,0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="MC Target:" Style="{StaticResource InputLabelStyle}" Margin="0,0,8,0" VerticalAlignment="Center"/>
							<TextBox Grid.Column="1" Text="{Binding TargetMarketCapInput, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,6" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Background="#2D2D2D" VerticalContentAlignment="Center"/>
						</Grid>

						<Grid Margin="0,6,0,0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="8"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<Grid Grid.Column="0">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<TextBlock Grid.Column="0" Text="Prezzo:" Style="{StaticResource InputLabelStyle}" Margin="0,0,4,0" VerticalAlignment="Center"/>
								<TextBox Grid.Column="1" Text="{Binding TokenPriceInput, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,6" VerticalContentAlignment="Center"/>
							</Grid>

							<Grid Grid.Column="2">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<TextBlock Grid.Column="0" Text="Supply:" Style="{StaticResource InputLabelStyle}" Margin="0,0,4,0" VerticalAlignment="Center"/>
								<TextBox Grid.Column="1" Text="{Binding TokenSupplyInput, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,6" VerticalContentAlignment="Center"/>
							</Grid>
						</Grid>

						<Grid Margin="0,16,0,0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="8"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<Button Grid.Column="0" Content="CALCOLA E SALVA" Command="{Binding CalculateCommand}" Background="{StaticResource ProfitBrush}" FontWeight="Bold" Height="40"/>
							<Button Grid.Column="2" Content="PULISCI" Command="{Binding ClearCommand}" Background="#444444" Foreground="#FFFFFF" Height="40"/>
						</Grid>

						<Border Background="#2A1A1A" BorderBrush="{StaticResource LossBrush}" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,10,0,0" Visibility="{Binding ShowError, Converter={StaticResource BoolToVisibilityConverter}}">
							<TextBlock Text="{Binding ErrorMessage}" Foreground="#FF6B6B" FontSize="11" TextWrapping="Wrap"/>
						</Border>
					</StackPanel>
				</Border>

				<Border Grid.Row="1" Style="{StaticResource CardStyle}">
					<StackPanel>
						<TextBlock Text="RISULTATI" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12"/>

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0" Margin="4">
								<TextBlock Text="ROI" Style="{StaticResource DescriptionLabelStyle}"/>
								<TextBlock Text="{Binding RoiDisplay}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource ProfitBrush}"/>
							</StackPanel>
							<StackPanel Grid.Column="1" Margin="4">
								<TextBlock Text="PROFITTO" Style="{StaticResource DescriptionLabelStyle}"/>
								<TextBlock Text="{Binding ProfitDisplay}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource ProfitBrush}"/>
							</StackPanel>
						</Grid>

						<Grid Margin="0,8,0,0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0" Margin="4">
								<TextBlock Text="VALORE FINALE" Style="{StaticResource DescriptionLabelStyle}"/>
								<TextBlock Text="{Binding FutureValueDisplay}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
							</StackPanel>
							<StackPanel Grid.Column="1" Margin="4">
								<TextBlock Text="MOLTIPLICATORE" Style="{StaticResource DescriptionLabelStyle}"/>
								<TextBlock Text="{Binding MultiplierDisplay}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
							</StackPanel>
						</Grid>

						<Grid Margin="0,8,0,0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0" Margin="4">
								<TextBlock Text="PREZZO STIMATO" Style="{StaticResource DescriptionLabelStyle}"/>
								<TextBlock Text="{Binding TokenPriceEstimateDisplay}" FontSize="18" FontWeight="Medium" Foreground="{StaticResource TextBrush}"/>
							</StackPanel>
							<StackPanel Grid.Column="1" Margin="4">
								<TextBlock Text="TOKEN ACQUISTATI" Style="{StaticResource DescriptionLabelStyle}"/>
								<TextBlock Text="{Binding TokensAcquiredDisplay}" FontSize="18" FontWeight="Medium" Foreground="{StaticResource TextBrush}"/>
							</StackPanel>
						</Grid>
					</StackPanel>
				</Border>
			</Grid>

			<!-- Right Panel: Grafici -->
			<Border Grid.Column="2" Style="{StaticResource CardStyle}">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*" MinHeight="250"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<Grid Grid.Row="0" Margin="0,0,0,10">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>

						<StackPanel Grid.Column="0" Orientation="Horizontal">
							<TextBlock Text=" GRAFICO" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,10,0"/>
							<TextBlock Text="ATH:" FontSize="11" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,5,0"/>
							<TextBlock Text="{Binding CurrentAth, StringFormat='${0:N6}'}" FontSize="11" FontWeight="Bold" Foreground="#00C853" VerticalAlignment="Center"/>
						</StackPanel>

						<TextBlock Grid.Column="1"/>

						<StackPanel Grid.Column="2" Orientation="Horizontal">
							<Button x:Name="Btn1H" Content="1H" Click="TimeframeButton_Click" Tag="1H" Background="#333333" Foreground="White" FontSize="10" FontWeight="Bold" Padding="10,5" Margin="2,0" Cursor="Hand"/>
							<Button x:Name="Btn4H" Content="4H" Click="TimeframeButton_Click" Tag="4H" Background="#333333" Foreground="White" FontSize="10" FontWeight="Bold" Padding="10,5" Margin="2,0" Cursor="Hand"/>
							<Button x:Name="Btn24H" Content="24H" Click="TimeframeButton_Click" Tag="24H" Background="#4A90E2" Foreground="White" FontSize="10" FontWeight="Bold" Padding="10,5" Margin="2,0" Cursor="Hand"/>
							<Button x:Name="Btn7D" Content="7D" Click="TimeframeButton_Click" Tag="7D" Background="#333333" Foreground="White" FontSize="10" FontWeight="Bold" Padding="10,5" Margin="2,0" Cursor="Hand"/>
							<Button x:Name="Btn1M" Content="1M" Click="TimeframeButton_Click" Tag="1M" Background="#333333" Foreground="White" FontSize="10" FontWeight="Bold" Padding="10,5" Margin="2,0" Cursor="Hand"/>
						</StackPanel>
					</Grid>

					<lvc:CartesianChart Grid.Row="1"
                                        Series="{Binding CandlestickSeries}"
                                        XAxes="{Binding CandlestickXAxes}"
                                        YAxes="{Binding CandlestickYAxes}"
                                        Background="Transparent"
                                        MinHeight="220"/>

					<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,5">
						<Ellipse Width="10" Height="10" Fill="#4A90E2" Margin="0,0,5,0"/>
						<TextBlock Text="Prezzo" FontSize="10" Foreground="#888888" Margin="0,0,15,0"/>
						<Ellipse Width="10" Height="10" Fill="#00C853" Margin="0,0,5,0"/>
						<TextBlock Text="Market Cap (nel tooltip)" FontSize="10" Foreground="#888888"/>
					</StackPanel>

					<TextBlock Grid.Row="3" Text=" GRAFICO PREDIZIONI" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,5,0,10"/>

					<lvc:CartesianChart Grid.Row="4"
                                        Series="{Binding PredictionSeries}"
                                        XAxes="{Binding PredictionXAxes}"
                                        YAxes="{Binding PredictionYAxes}"
                                        Background="Transparent"
                                        MinHeight="220"/>

					<WrapPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0" VerticalAlignment="Center">
						<CheckBox IsChecked="{Binding AutoRefreshEnabled}" Content="🔄" Foreground="#FFFFFF" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Auto-refresh"/>
						<TextBlock Text="{Binding LastRefreshDisplay}" FontSize="10" Foreground="#00C853" VerticalAlignment="Center" Margin="0,0,12,0"/>

						<Button Content=" CSV" Command="{Binding ExportHistoryCsvCommand}" Background="#4A90E2" Foreground="White" FontSize="9" Padding="8,4" Margin="2,0" Cursor="Hand" Height="26"/>
						<Button Content=" CSV" Command="{Binding ExportWalletsCsvCommand}" Background="#4A90E2" Foreground="White" FontSize="9" Padding="8,4" Margin="2,0" Cursor="Hand" Height="26"/>
						<Button Content=" PDF" Command="{Binding ExportHistoryPdfCommand}" Background="#FF6B35" Foreground="White" FontSize="9" Padding="8,4" Margin="2,0" Cursor="Hand" Height="26"/>
						<Button Content=" PDF" Command="{Binding ExportWalletsPdfCommand}" Background="#FF6B35" Foreground="White" FontSize="9" Padding="8,4" Margin="2,0" Cursor="Hand" Height="26"/>
					</WrapPanel>
				</Grid>
			</Border>
		</Grid>

		<!-- RIGA 5: History Panel -->
		<Expander Grid.Row="4" Margin="4" IsExpanded="False">
			<Expander.Header>
				<StackPanel Orientation="Horizontal">
					<TextBlock Text=" STORIA PREDIZIONI (Ultime 50)" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
				</StackPanel>
			</Expander.Header>

			<Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,8,0,0">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<Button Grid.Row="0" Content="CANCELLA STORIA" Command="{Binding ClearHistoryCommand}" Background="#FF5252" FontSize="10" Padding="8,4" HorizontalAlignment="Right" Margin="0,0,0,8"/>

					<DataGrid Grid.Row="1" ItemsSource="{Binding PredictionHistory}" AutoGenerateColumns="False" Background="Transparent" BorderThickness="0" RowBackground="#1E1E1E" AlternatingRowBackground="#1A1A1A" Foreground="{StaticResource TextBrush}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrush}" HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" MaxHeight="200">
						<DataGrid.Columns>
							<DataGridTextColumn Header="DATA" Binding="{Binding DisplayTimestamp}" Width="*"/>
							<DataGridTextColumn Header="TOKEN" Binding="{Binding TokenName}" Width="*"/>
							<DataGridTextColumn Header="MC ATTUALE" Binding="{Binding DisplayMarketCap}" Width="*"/>
							<DataGridTextColumn Header="MC TARGET" Binding="{Binding DisplayTarget}" Width="*"/>
							<DataGridTextColumn Header="ROI" Binding="{Binding DisplayROI}" Width="*"/>
							<DataGridTextColumn Header="PROFITTO" Binding="{Binding DisplayProfit}" Width="*"/>
						</DataGrid.Columns>
						<DataGrid.ColumnHeaderStyle>
							<Style TargetType="DataGridColumnHeader">
								<Setter Property="Background" Value="#2A2A2A"/>
								<Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
								<Setter Property="FontWeight" Value="Bold"/>
